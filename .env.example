# Stripe — copy real values into Vercel's dashboard
# (Project → Settings → Environment Variables), NOT into a committed file.

# Secret key, server-side only. Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret. Created after you add a webhook endpoint pointing at
# https://<your-domain>/api/stripe-webhook in Dashboard → Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio — powers the rep portal's in-browser Dialer (api/twilio-token.js, api/twiml.js).
# Console → Account → API keys & tokens for the account SID; create a separate
# "Standard" API key there for TWILIO_API_KEY / TWILIO_API_SECRET (do NOT reuse the
# account Auth Token here — the Voice SDK requires a dedicated API key pair).
TWILIO_ACCOUNT_SID=AC...
TWILIO_API_KEY=SK...
TWILIO_API_SECRET=...
# Console → Voice → TwiML Apps → create one with Voice Request URL = https://<your-domain>/api/twiml
TWILIO_TWIML_APP_SID=AP...
# A Twilio number you own, E.164 format — used as the outbound caller ID.
TWILIO_CALLER_ID=+1...

# Without all five Twilio vars set, the Dialer falls back to the device's native tel: dialer.
# Email Magic Link and SMS sign-in are configured separately, in Supabase's own dashboard —
# not here. See auth-config.js for the checklist.

# Cal.com — powers the admin dashboard's real consult/booking data (api/cal-bookings.js).
# Dashboard → Settings → Developer → API Keys → create a key.
CALCOM_API_KEY=cal_live_...

# Supabase — used ONLY server-side, by api/create-deposit-session.js (to read the
# authoritative deposit amount, never trusting the client), api/stripe-webhook.js (to
# confirm a deposit payment and mark the project stage done after Stripe's signature is
# verified), api/invite-rep.js (to create a new rep account and set its role — RLS
# deliberately blocks any client-side role change, even by an admin), and
# api/impersonate.js (to generate a one-time sign-in link so an admin can view a client's
# portal). This is the service_role key, NOT the anon key already in auth-config.js —
# it completely bypasses Row Level Security. Get it from Supabase Dashboard → Project
# Settings → API → Project API keys → service_role ("secret" — keep this out of any
# committed file, out of the browser, and out of chat; only paste it into Vercel's env vars).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI — server-side only. Powers the homepage site's audit lead brief and
# human-reviewable follow-up draft. Create a restricted project key in the OpenAI
# dashboard and add it in Vercel; never place it in auth-config.js or any browser code.
# Optional: set OPENAI_LEAD_BRIEF_MODEL to change the Responses API model.
OPENAI_API_KEY=sk-...
# OPENAI_LEAD_BRIEF_MODEL=gpt-5.4
