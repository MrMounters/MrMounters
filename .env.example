# Stripe — copy real values into Vercel's dashboard
# (Project → Settings → Environment Variables), NOT into a committed file.

# Secret key, server-side only. Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret. Created after you add a webhook endpoint pointing at
# https://<your-domain>/api/stripe-webhook in Dashboard → Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio — powers the rep portal's in-browser Dialer (api/twilio-token.js, api/twiml.js).
# Console → Account → API keys & tokens for the account SID; create a separate
# "Standard" API key there for TWILIO_API_KEY / TWILIO_API_SECRET (do NOT reuse the
# account Auth Token here — the Voice SDK requires a dedicated API key pair).
TWILIO_ACCOUNT_SID=AC...
TWILIO_API_KEY=SK...
TWILIO_API_SECRET=...
# Console → Voice → TwiML Apps → create one with Voice Request URL = https://<your-domain>/api/twiml
TWILIO_TWIML_APP_SID=AP...
# A Twilio number you own, E.164 format — used as the outbound caller ID.
TWILIO_CALLER_ID=+1...

# Without all five Twilio vars set, the Dialer falls back to the device's native tel: dialer.
# Email Magic Link and SMS sign-in are configured separately, in Supabase's own dashboard —
# not here. See auth-config.js for the checklist.

# Cal.com — powers the admin dashboard's real consult/booking data (api/cal-bookings.js).
# Dashboard → Settings → Developer → API Keys → create a key.
CALCOM_API_KEY=cal_live_...
